        "exec": [
          "const perUserKey = pm.environment.get(\"perUserKey\");\r",
          "const apiKey = pm.environment.get(\"api_key\");\r",
          "const secret = pm.environment.get(\"api_secret\");\r",
          "\r",
          "// ===== DATE =====\r",
          "let now = new Date();\r",
          "let yyyy = now.getFullYear();\r",
          "let mm = String(now.getMonth() + 1).padStart(2, '0');\r",
          "let dd = String(now.getDate()).padStart(2, '0');\r",
          "\r",
          "// ===== X-API-SECRET =====\r",
          "let rawSecret = `${perUserKey}:${yyyy}${mm}${dd}`;\r",
          "pm.variables.set(\"x-api-secret\", btoa(rawSecret));\r",
          "\r",
          "// ===== TIMESTAMP =====\r",
          "let timestamp = Math.floor(Date.now() / 1000);\r",
          "pm.variables.set(\"timestamp\", timestamp);\r",
          "\r",
          "// ===== SIGNATURE =====\r",
          "let signature = CryptoJS.MD5(apiKey + secret + timestamp).toString();\r",
          "pm.variables.set(\"signature\", signature);\r",
          "\r",
          "// ===== BASIC AUTH =====\r",
          "let username = pm.environment.get(\"username\");\r",
          "let password = pm.environment.get(\"password\");\r",
          "pm.variables.set(\"basic_auth\", btoa(`${username}:${password}`));"
        ]
      }
